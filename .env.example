# The submitting organization is REQUIRED for `create`: NAME for every
# profile, OR_ID (the organization's identifier in meemoo's organization
# register) for meemoo profiles.
SIP_SUBMITTER_NAME="Universiteitsbibliotheek Gent"
SIP_SUBMITTER_OR_ID="OR-a1b2c3d" # replace with your real OR-id

# Format identification is OPTIONAL (premis:format is a SHOULD): leave these
# unset (or omit this file entirely) to build without it. Fixity is computed
# natively, so siegfried no longer needs -hash.
SIP_FILE_FORMAT_NAME="siegfried"
SIP_FILE_FORMAT_COMMAND="~/bin/sf" # path to siegfried binary
SIP_FILE_FORMAT_ARGS="-json"
