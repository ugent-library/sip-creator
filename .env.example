# The submitting organization is REQUIRED for `create`: NAME for every
# profile, OR_ID (the organization's identifier in meemoo's organization
# register) for meemoo profiles.
SIP_SUBMITTER_NAME="Example Organization"
SIP_SUBMITTER_OR_ID="OR-a1b2c3d" # replace with your real OR-id

# Format characterization is not configured here (ADR-0009): put a
# Siegfried report named siegfried.json in the input folder instead. Capture
# the report before writing it, so sf does not scan its own half-written
# output (see the README, "Format characterization"):
#   cd ./your-input && report="$(sf -hash md5 -json .)" && printf '%s\n' "$report" > siegfried.json
